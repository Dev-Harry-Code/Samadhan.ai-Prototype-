# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/samadhan?appName=<appName>

# JWT secret for session tokens
JWT_SECRET=replace-with-a-strong-random-string

# Optional: AI pipeline key (runs offline when absent)
AI_API_KEY=

# Optional: Vercel Blob storage (for photo uploads)
BLOB_READ_WRITE_TOKEN=

# Optional: allow POST /api/dev/reset even in production
ALLOW_RESET=

# Optional: SMTP email delivery for the citizen email-OTP login (defaults to Gmail).
# With Gmail, SMTP_USER is your Gmail address and SMTP_PASS is an App Password
# (https://myaccount.google.com/apppasswords). When unset the flow runs in demo
# mode: the code is shown on screen.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Samadhan.ai <your-address@gmail.com>
